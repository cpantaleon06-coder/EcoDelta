    }
   },
   "required": [
    "first",
    "last",
    "step",
    "n"
   ],
   "type": "object"
  },
  "lon": {
   "properties": {
    "first": {
     "type": "number"
    },
    "last": {
     "type": "number"
    },
    "n": {
     "minimum": 0,
     "type": "integer"
    },
    "step": {
