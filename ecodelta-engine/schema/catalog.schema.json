{
 "$id": "ecodelta/catalog.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "type": "string"
  },
  "variables": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "caveats": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "definition": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "increase_means": {
      "type": "string"
     },
     "land_only": {
      "type": "boolean"
     },
     "long_name": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "period": {
      "items": {
       "pattern": "^\\d{4}-\\d{2}$",
       "type": "string"
      },
      "type": "array"
     },
     "product": {
      "additionalProperties": false,
      "properties": {
       "citation": {
        "type": "string"
       },
       "doi": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "short_name": {
        "type": "string"
       },
       "source_variable": {
        "type": "string"
       },
       "unit_conversion": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "citation",
       "doi",
       "name",
       "short_name",
       "source_variable",
       "unit_conversion",
       "version"
      ],
      "type": "object"
     },
     "provenance": {
      "additionalProperties": false,
      "description": "Where the numbers come from. Data fields are copied from the data build's manifest.json (read from CMR and the source files there); null means the value could not be retrieved.",
      "properties": {
       "collection_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "displayed_units": {
        "type": "string"
       },
       "doi": {
        "type": [
         "string",
         "null"
        ]
       },
       "engine_commit": {
        "type": [
         "string",
         "null"
        ]
       },
       "engine_uncommitted_changes": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "grid": {
        "type": "object"
       },
       "manifest_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "type": [
         "string",
         "null"
        ]
       },
       "native_resolution": {
        "type": [
         "object",
         "null"
        ]
       },
       "period": {
        "items": {
         "pattern": "^\\d{4}-\\d{2}$",
         "type": "string"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
       },
       "processing_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "detail": {
           "type": [
            "string",
            "null"
           ]
          },
          "step": {
           "type": "string"
          }
         },
         "required": [
          "step",
          "detail"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "product_short_name": {
        "type": [
         "string",
         "null"
        ]
       },
       "retrieved": {
        "type": [
         "object",
         "null"
        ]
       },
       "source_units": {
        "type": [
         "string",
         "null"
        ]
       },
       "source_variable": {
        "type": [
         "string",
         "null"
        ]
       },
       "statistics": {
        "additionalProperties": false,
        "properties": {
         "alpha": {
          "type": "number"
         },
         "autocorrelation_handling": {
          "type": "string"
         },
         "autocorrelation_note": {
          "type": "string"
         },
         "ci_level": {
          "type": "number"
         },
         "climatology_base_period": {
          "type": "array"
         },
         "data_requirement": {
          "type": "string"
         },
         "deseasonalizing": {
          "type": "string"
         },
         "fdr": {
          "type": "object"
         },
         "regional_mean": {
          "type": "string"
         },
         "significance_test": {
          "type": "string"
         },
         "trend_estimator": {
          "type": "string"
         },
         "trendkit_version": {
          "type": "string"
         }
        },
        "required": [
         "trendkit_version",
         "deseasonalizing",
         "climatology_base_period",
         "trend_estimator",
         "significance_test",
         "autocorrelation_handling",
         "autocorrelation_note",
         "alpha",
         "ci_level",
         "fdr",
         "data_requirement",
         "regional_mean"
        ],
        "type": "object"
       },
       "temporal_resolution": {
        "type": [
         "object",
         "null"
        ]
       },
       "units": {
        "type": "string"
       },
       "version": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "collection_id",
       "displayed_units",
       "doi",
       "engine_commit",
       "engine_uncommitted_changes",
       "grid",
       "manifest_sha256",
       "native_resolution",
       "period",
       "processing_steps",
       "product_short_name",
       "retrieved",
       "source_units",
       "source_variable",
       "statistics",
       "temporal_resolution",
       "units",
       "version"
      ],
      "type": "object"
     },
     "public_unit": {
      "type": "string"
     },
     "units": {
      "type": "string"
     }
    },
    "required": [
     "caveats",
     "definition",
     "id",
     "increase_means",
     "land_only",
     "long_name",
     "name",
     "period",
     "product",
     "provenance",
     "public_unit",
     "units"
    ],
    "type": "object"
   },
   "minItems": 1,
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "variables"
 ],
 "title": "EcoDelta catalog file",
 "type": "object"
}
