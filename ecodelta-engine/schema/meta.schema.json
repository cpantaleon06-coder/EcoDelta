{
 "$id": "ecodelta/meta.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "build_date": {
   "type": "string"
  },
  "data": {
   "additionalProperties": false,
   "description": "Which data build was used: SHA-256 of nasa-data/data/processed/manifest.json as read.",
   "properties": {
    "manifest_sha256": {
     "pattern": "^[0-9a-f]{64}$",
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "manifest_sha256"
   ],
   "type": "object"
  },
  "engine": {
   "additionalProperties": true,
   "properties": {
    "commit": {
     "type": [
      "string",
      "null"
     ]
    },
    "uncommitted_changes": {
     "type": [
      "boolean",
      "null"
     ]
    }
   },
   "required": [
    "commit",
    "uncommitted_changes"
   ],
   "type": "object"
  },
  "grid": {
   "additionalProperties": false,
   "properties": {
    "cell_reference": {
     "type": "string"
    },
    "lat": {
     "properties": {
      "first": {
       "type": "number"
      },
      "last": {
       "type": "number"
      },
      "n": {
       "minimum": 0,
       "type": "integer"
      },
      "step": {
       "type": "number"
      }
     },
     "required": [
      "first",
      "last",
      "step",
      "n"
     ],
     "type": "object"
    },
    "lon": {
     "properties": {
      "first": {
       "type": "number"
      },
      "last": {
       "type": "number"
      },
      "n": {
       "minimum": 0,
       "type": "integer"
      },
      "step": {
       "type": "number"
      }
     },
     "required": [
      "first",
      "last",
      "step",
      "n"
     ],
     "type": "object"
    },
    "resolution_deg": {
     "type": "number"
    }
   },
   "required": [
    "cell_reference",
    "lat",
    "lon",
    "resolution_deg"
   ],
   "type": "object"
  },
  "limitations": {
   "items": {
    "type": "string"
   },
   "minItems": 1,
   "type": "array"
  },
  "methods": {
   "properties": {
    "evidence_classes": {
     "additionalProperties": {
      "type": "string"
     },
     "required": [
      "strong",
      "moderate",
      "weak",
      "none",
      "insufficient data",
      "coverage_cap",
      "maps"
     ],
     "type": "object"
    },
    "fdr": {
     "properties": {
      "applies_to": {
       "type": "string"
      },
      "method": {
       "type": "string"
      },
      "q": {
       "type": "number"
      },
      "spatial_dependence": {
       "type": "string"
      }
     },
     "required": [
      "applies_to",
      "method",
      "q",
      "spatial_dependence"
     ],
     "type": "object"
    },
    "magnitude": {
     "type": "string"
    },
    "orderings": {
     "additionalProperties": false,
     "properties": {
      "by_evidence": {
       "type": "string"
      },
      "by_magnitude": {
       "type": "string"
      }
     },
     "required": [
      "by_evidence",
      "by_magnitude"
     ],
     "type": "object"
    },
    "region_comparison": {
     "type": "string"
    },
    "regional_mean_rule": {
     "additionalProperties": false,
     "properties": {
      "max_missing_weight": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "min_valid_fraction": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "mode": {
       "enum": [
        "fixed_mask",
        "all_valid_cells"
       ]
      }
     },
     "required": [
      "max_missing_weight",
      "min_valid_fraction",
      "mode"
     ],
     "type": "object"
    }
   },
   "required": [
    "alpha",
    "autocorrelation_handling",
    "climatology_base_period",
    "display_series",
    "evidence_classes",
    "fdr",
    "magnitude",
    "orderings",
    "ranking",
    "region_comparison",
    "regional_mean_rule",
    "rounding"
   ],
   "type": "object"
  },
  "period": {
   "additionalProperties": false,
   "properties": {
    "end": {
     "pattern": "^\\d{4}-\\d{2}$",
     "type": "string"
    },
    "n_months": {
     "minimum": 0,
     "type": "integer"
    },
    "start": {
     "pattern": "^\\d{4}-\\d{2}$",
     "type": "string"
    },
    "years": {
     "type": "number"
    }
   },
   "required": [
    "end",
    "n_months",
    "start",
    "years"
   ],
   "type": "object"
  },
  "products": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "citation": {
      "type": "string"
     },
     "doi": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "short_name": {
      "type": "string"
     },
     "variables": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "citation",
     "doi",
     "name",
     "short_name",
     "variables",
     "version"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "quality_gate": {
   "additionalProperties": false,
   "properties": {
    "counts": {
     "additionalProperties": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object"
     },
     "type": "object"
    },
    "decision": {
     "type": [
      "string",
      "null"
     ]
    },
    "held": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "reason": {
        "type": "string"
       },
       "region": {
        "type": "string"
       },
       "variable": {
        "type": "string"
       }
      },
      "required": [
       "reason",
       "region",
       "variable"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "references": {
     "type": "object"
    },
    "rule": {
     "type": "string"
    },
    "version": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "counts",
    "decision",
    "held",
    "references",
    "rule",
    "version"
   ],
   "type": "object"
  },
  "sanity_checks": {
   "type": "object"
  },
  "schema_version": {
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "type": "string"
  },
  "source": {
   "enum": [
    "fixture",
    "real"
   ]
  },
  "synthetic": {
   "type": "boolean"
  },
  "timing": {
   "type": "object"
  },
  "trendkit": {
   "additionalProperties": true,
   "properties": {
    "commit": {
     "type": [
      "string",
      "null"
     ]
    },
    "uncommitted_changes": {
     "type": [
      "boolean",
      "null"
     ]
    }
   },
   "required": [
    "commit",
    "uncommitted_changes"
   ],
   "type": "object"
  },
  "variables_included": {
   "items": {
    "type": "string"
   },
   "minItems": 1,
   "type": "array"
  },
  "variables_missing": {
   "items": {
    "type": "string"
   },
   "type": "array"
  }
 },
 "required": [
  "build_date",
  "data",
  "engine",
  "grid",
  "limitations",
  "methods",
  "period",
  "products",
  "quality_gate",
  "sanity_checks",
  "schema_version",
  "source",
  "synthetic",
  "timing",
  "trendkit",
  "variables_included",
  "variables_missing"
 ],
 "title": "EcoDelta meta file",
 "type": "object"
}
