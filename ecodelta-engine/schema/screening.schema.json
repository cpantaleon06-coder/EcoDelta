{
 "$id": "ecodelta/screening.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "by_evidence": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "by_magnitude": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "ranking": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "abs_effect_size": {
      "type": [
       "number",
       "null"
      ]
     },
     "cautions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "cells_significant_fraction": {
      "maximum": 1,
      "minimum": 0,
      "type": [
       "number",
       "null"
      ]
     },
     "ci_per_decade": {
      "items": {
       "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": [
       "array",
       "null"
      ]
     },
     "effect_size": {
      "type": [
       "number",
       "null"
      ]
     },
     "evidence_class": {
      "enum": [
       "strong",
       "moderate",
       "weak",
       "none",
       "insufficient data"
      ]
     },
     "name": {
      "type": "string"
     },
     "public_unit": {
      "type": "string"
     },
     "pvalue": {
      "type": [
       "number",
       "null"
      ]
     },
     "rank": {
      "minimum": 1,
      "type": "integer"
     },
     "rank_by_magnitude": {
      "minimum": 1,
      "type": "integer"
     },
     "sentence": {
      "type": "string"
     },
     "significant": {
      "type": "boolean"
     },
     "slope_per_decade": {
      "type": [
       "number",
       "null"
      ]
     },
     "standardized_change": {
      "type": [
       "number",
       "null"
      ]
     },
     "tier": {
      "enum": [
       0,
       1,
       2
      ]
     },
     "total_change": {
      "type": [
       "number",
       "null"
      ]
     },
     "variable": {
      "type": "string"
     },
     "verdict": {
      "enum": [
       "increasing",
       "decreasing",
       "no significant trend",
       "insufficient data"
      ]
     }
    },
    "required": [
     "abs_effect_size",
     "cautions",
     "cells_significant_fraction",
     "ci_per_decade",
     "effect_size",
     "evidence_class",
     "name",
     "public_unit",
     "pvalue",
     "rank",
     "rank_by_magnitude",
     "sentence",
     "significant",
     "slope_per_decade",
     "standardized_change",
     "tier",
     "total_change",
     "variable",
     "verdict"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "region_file": {
   "type": "string"
  },
  "region_id": {
   "type": "string"
  },
  "schema_version": {
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "type": "string"
  }
 },
 "required": [
  "by_evidence",
  "by_magnitude",
  "ranking",
  "region_file",
  "region_id",
  "schema_version"
 ],
 "title": "EcoDelta screening file",
 "type": "object"
}
